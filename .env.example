# GEMINI_API_KEY: Reserved by AI Studio runtime environment (Not used by SIET-LMS Offline local tutor).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SIET-LMS Offline — Local Gemma / Ollama Runtime Configuration
# Configure these when running SIET-LMS Offline locally on Windows, Linux, or Android.
VITE_LOCAL_AI_BACKEND="ollama_local"
VITE_LOCAL_AI_BASE_URL="http://127.0.0.1:11434"
VITE_LOCAL_AI_MODEL="gemma4:e4b"
